#!/usr/bin/env sh

# Add nvm-managed Node.js to PATH (POSIX-safe — nvm.sh requires bash but husky uses sh/dash)
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -d "$NVM_DIR/versions/node" ]; then
  # nvm directories use only alphanumeric names; find is unnecessarily complex here
  # shellcheck disable=SC2012
  NODE_BIN="$(ls -td "$NVM_DIR/versions/node/"*/bin 2>/dev/null | head -1)"
  [ -d "$NODE_BIN" ] && PATH="$NODE_BIN:$PATH" && export PATH
fi

# Primary: run lint-staged
# Both node AND npx must be available — husky's h script adds node_modules/.bin
# to PATH, so npx is "found" even in MINGW where node itself is missing.
# Without the node check, npx (#!/usr/bin/env node) fails with code 127.
if command -v node >/dev/null 2>&1 && command -v npx >/dev/null 2>&1; then
  npx lint-staged
  exit $?
fi

# Fallback: Windows Git client (GitHub Desktop, VS Code)
# In MINGW bash, node isn't available — delegate to WSL where node lives
if command -v wsl.exe >/dev/null 2>&1; then
  WSL_DIR="$(pwd | sed 's|^//wsl\.localhost/[^/]*||')"
  if [ -n "$WSL_DIR" ]; then
    wsl.exe bash -lc "cd \"${WSL_DIR}\" && npx lint-staged"
    exit $?
  fi
fi

echo "husky: npx not found — skipping pre-commit hook"
exit 0
