# ─── Core (required) ─────────────────────────────────────────────────────────
# Claude/Anthropic key used by:
# - scripts/generate-resume.ts, scripts/generate-tailored-resume.ts
# - app/api/chat/route.ts runtime
# - app/api/cron/route.ts warmup
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vercel API token used by local CLI/deploy scripts and CI workflows.
# Token can manage project settings, environment vars, and deployments.
# https://vercel.com/account/settings/tokens
VERCEL_TOKEN=vercel_abcdefghijklmnopqrstuvwxyz

# Vercel deployment protection bypass (for local smoke tests against preview URLs)
# Used by scripts/smoke-test.ts for preview site checks.
VERCEL_AUTOMATION_BYPASS_SECRET=local-preview-bypass-secret

# CRON endpoint authorization secret (app/api/cron/). Must match Vercel cron job config.
CRON_SECRET=cron-webhook-secret

# ─── Optional / recommended for chat rate limiting and gateway ----------------
# Upstash Redis rate limit (Phase 2 chat API optional; required if no local ratelimit fallback).
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=upstash-xxxxxxxxxxxxxxxxxxx

# Vercel KV compatibility layer alternative to Upstash Redis.
KV_REST_API_URL=https://<your-instance>.upstash.io
KV_REST_API_TOKEN=kv-xxxxxxxxxxxxxxxxxxx

# Optional Vercel AI Gateway (observability, budgeting, model routing).
AI_GATEWAY_API_KEY=vgw_abcdefghijklmnopqrstuvwxyz

# Optional GitHub CLI auth for repo scripts (not required for website runtime).
GH_TOKEN=github_pat_abcdefghijklmnopqrstuvwxyz

