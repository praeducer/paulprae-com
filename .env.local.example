# ─── Resume Generation Pipeline (Phase 1) ───────────────────────────────────
# Required for: npm run generate (Claude AI resume generation)
# Not needed for: npm run dev, npm run build (website development)
# Get your key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_key_here

# ─── Phase 2: Chat API Runtime ──────────────────────────────────────────────
# Required for: /api/chat endpoint (streaming AI responses)
# These must also be set as Vercel Environment Variables for production.
# Note: ANTHROPIC_API_KEY above is reused for both pipeline and runtime.
# Upstash Redis for rate limiting — supports both naming conventions:
# Direct Upstash: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# Vercel KV integration: KV_REST_API_URL / KV_REST_API_TOKEN
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
# KV_REST_API_URL=https://your-instance.upstash.io
# KV_REST_API_TOKEN=your_token_here
# Vercel AI Gateway (optional — enables observability, budget controls, model routing)
# Auto-detected on Vercel via VERCEL_OIDC_TOKEN. Only needed locally if testing gateway.
# AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# ─── Smoke Testing (optional) ───────────────────────────────────────────────
# Allows local smoke tests to bypass Vercel deployment protection on preview URLs.
# Value lives in Vercel: Project Settings → Deployment Protection → Bypass Secret.
# VERCEL_AUTOMATION_BYPASS_SECRET=your_bypass_secret_here

# ─── GitHub CLI Authentication (optional) ───────────────────────────────────
# Required for: gh commands in WSL terminal (PR creation, branch protection)
# Not needed for: Claude Code (uses Windows gh.exe), CI, website development
# Create at: https://github.com/settings/tokens → Fine-grained personal access tokens
# Scopes needed: Contents (read/write), Pull Requests (read/write)
# GH_TOKEN=github_pat_your_token_here
